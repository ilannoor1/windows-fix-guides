  ],
  "commands": [
    {
      "purpose": "BIOS serial number",
      "wmic": "wmic bios get serialnumber",
      "powershell": "Get-CimInstance Win32_BIOS | Select-Object SerialNumber"
    },
    {
      "purpose": "Computer manufacturer and model",
      "wmic": "wmic computersystem get manufacturer,model",
      "powershell": "Get-CimInstance Win32_ComputerSystem | Select-Object Manufacturer,Model"
    },
    {
      "purpose": "CPU name",
      "wmic": "wmic cpu get name",
      "powershell": "Get-CimInstance Win32_Processor | Select-Object Name"
    },
    {
      "purpose": "Installed RAM",
      "wmic": "wmic memorychip get capacity",
      "powershell": "Get-CimInstance Win32_PhysicalMemory | Select-Object Capacity"
    },
    {
      "purpose": "Disk model and size",
      "wmic": "wmic diskdrive get model,size",
      "powershell": "Get-CimInstance Win32_DiskDrive | Select-Object Model,Size"
    }
  ]
}
